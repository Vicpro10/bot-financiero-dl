# Copie este archivo como .env y ponga valores propios. NUNCA suba .env al repositorio.
# Clave secreta del backend (>=16 caracteres). Genere una con: python -c "import secrets;print(secrets.token_urlsafe(32))"
AGENT_API_KEY=
SYMBOL=BTCUSDT
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
LIVE_POLL_SECONDS=300
REPLAY_STEP_SECONDS=0.3
ENABLE_FAULT_INJECTION=true
# No se necesita clave de MEXC: solo se usan datos publicos. No configure claves de trading.
